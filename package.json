    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.3.0",
    "@mediabunny/mp3-encoder": "^1.0.0",
